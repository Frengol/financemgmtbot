# Backend local configuration
PORT=8080
APP_COMPONENT=api

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_SECRET_TOKEN=your-telegram-webhook-secret

# Durable Telegram queue (API component only). Production uses the Cloud Run
# attached identity; local ADC is not required for unit tests with an injected client.
TELEGRAM_TASKS_PROJECT=financemgmtbot
TELEGRAM_TASKS_LOCATION=southamerica-east1
TELEGRAM_TASKS_QUEUE=telegram-updates
TELEGRAM_WORKER_URL=https://financemgmtbot-worker-example.a.run.app
TELEGRAM_TASK_INVOKER_SERVICE_ACCOUNT=financemgmtbot-task-invoker@financemgmtbot.iam.gserviceaccount.com

# Supabase backend/service access
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
# Optional table override for local QA. Cloud Run production should stay on `gastos`.
SUPABASE_GASTOS_TABLE=gastos

# AI providers
DEEPSEEK_API_KEY=your-deepseek-api-key
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Admin protection
SUPABASE_ADMIN_EMAILS=admin@example.com
# Optional alternative to email allowlist
SUPABASE_ADMIN_USER_IDS=

# Frontend origins allowed to call the backend
# In Cloud Run production, this must include the published Pages origin (for example https://frengol.github.io)
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,https://admin.example.com

# Public auth URLs used by the GitHub Pages login flow
# In Cloud Run production, this must point to the published Pages base URL
FRONTEND_PUBLIC_URL=https://admin.example.com/

# Optional dev/test flags
# Keep both flags false in Cloud Run production
ALLOW_LOCAL_DEV_AUTH=false
AUTH_TEST_MODE=false
# When AUTH_TEST_MODE=true, keep `seeded` for automated integration tests and use
# `database` to exercise the real local QA table (`gastos_qa`) through the test magic-link flow.
AUTH_TEST_DATA_SOURCE=seeded

# Optional encrypted pending-payload key
DATA_ENCRYPTION_KEY=

# Shared secret protecting the daily recurring-expenses cron endpoint
# Required in Cloud Run production. Same value must be configured in GitHub Secrets
# as RECURRING_EXPENSES_CRON_SECRET for the scheduled workflow to authenticate.
RECURRING_EXPENSES_CRON_SECRET=
